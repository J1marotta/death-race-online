{
  "name": "deathrace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --environment jsdom",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:migration": "node server/dev.js",
    "dev:colyseus": "node --watch server/index.js",
    "start:colyseus": "node server/index.js",
    "test:colyseus": "vitest run --environment node server src/multiplayer/protocol.test.js",
    "preview:cloudflare": "npm run build && wrangler pages dev dist",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist",
    "dev:rooms": "wrangler dev workers/rooms.js",
    "deploy:rooms": "wrangler deploy --config wrangler.worker.jsonc"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.42",
    "@colyseus/schema": "^4.0.27",
    "@colyseus/ws-transport": "^0.17.13",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
